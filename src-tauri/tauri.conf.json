{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meetin",
  "version": "1.3.0",
  "identifier": "com.meetin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meetin",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": true
      },
      {
        "label": "mascot",
        "title": "Meetin Maskot",
        "width": 100,
        "height": 100,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "bubble",
        "title": "Meetin Balon",
        "width": 104,
        "height": 42,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "hoop",
        "title": "Meetin Basket",
        "width": 170,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["Turkish"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
